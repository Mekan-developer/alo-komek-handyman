meta {
  name: Get Receipt
  type: http
  seq: 10
}

get {
  url: {{base_url}}/api/v1/master/orders/{{order_id}}/receipt
  body: none
  auth: bearer
}

auth:bearer {
  token: {{master_token}}
}

headers {
  Accept: application/json
}

docs {
  # Get Receipt

  Returns the receipt of a **completed** order so the master can show it to
  the client on the spot. It is an immutable snapshot taken the moment the
  order was completed: client, master, every priced task as its own line, and
  the total on the last line.

  Tasks left **without a price** are not listed and do not count towards the
  total.

  **Response 200:**
  ```json
  {
    "data": {
      "id": 1,
      "order_id": 12,
      "number": "824-0036",
      "client_name": "Emil",
      "client_phone": "+99362111222",
      "master_name": "Gurban Azadow",
      "master_phone": "+99365111222",
      "category_name": "Сантехника",
      "subtotal": 100,
      "discount_percent": 10,
      "discount_amount": 10,
      "total": 90,
      "currency": "TMT",
      "items": [
        { "id": 1, "title": "Замена смесителя", "description": null, "price": 30 },
        { "id": 2, "title": "Прочистка сифона", "description": null, "price": 70 }
      ],
      "issued_at": "2026-08-24 11:31:00",
      "issued_date": "24.08.26",
      "issued_time": "11:31"
    }
  }
  ```

  **Errors:**
  - `404` — order not found, assigned to another master, or not completed yet
  - `401` — missing / invalid master token
}
