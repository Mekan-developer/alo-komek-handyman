meta {
  name: Verify OTP
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/master/auth/verify-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "phone": "+99361000003",
    "code": "041039"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("token", res.body.token);
  }
}

docs {
  # Verify OTP

  Verifies the OTP and returns a Sanctum Bearer token (`mobile`).
  The script saves the token to the `token` env variable.

  Rate limited: 10/min per IP, 5/min per phone (`throttle:otp-verify`).
  After **5 failed** attempts the cached OTP is discarded.

  Token lifetime: `SANCTUM_TOKEN_EXPIRATION` minutes (default 30 days).

  **Response 200:**
  ```json
  {
    "token": "1|abc...",
    "master": {
      "id": 1,
      "name": "Aydogdy Ussadow",
      "phone": "+99362111222",
      "balance": 250.00,
      "is_active": true,
      "access_expires_at": "2026-12-31",
      "categories": [{ "id": 1, "name": "Сантехника" }]
    }
  }
  ```

  **Errors:**
  - `404` — master phone not registered (`exists:masters,phone`)
  - `403` — master inactive / access expired
  - `422` — invalid or expired OTP
  - `429` — too many requests
}
