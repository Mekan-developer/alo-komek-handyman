meta {
  name: Send Location (no order)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/master/location
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "latitude": 37.920000,
    "longitude": 58.390000
  }
}

docs {
  # Send Location (minimal ping)

  Master is online but not tied to a specific order trip.
  Requires Sanctum Bearer token (`POST /api/v1/master/location`).
  Backend defaults `recorded_at` to server now().

  Broadcasts to private admin channel `masters-map`.

  **Errors:**
  - `401` — missing / invalid token
  - `403` — inactive / expired master
  - `422` — validation error
}
