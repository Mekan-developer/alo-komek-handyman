meta {
  name: Update Profile
  type: http
  seq: 2
}

patch {
  url: {{base_url}}/api/v1/client/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{client_token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "name": "Merdan Annagurdow"
  }
}

docs {
  # Update Client Profile

  `name` is optional (`sometimes`) — send it only when it needs to change.
  It must be set before the client can create orders.

  **Response 200:**
  ```json
  {
    "data": {
      "id": 1,
      "name": "Merdan Annagurdow",
      "phone": "+99361111222"
    }
  }
  ```

  **Errors:**
  - `422` — validation error
}
