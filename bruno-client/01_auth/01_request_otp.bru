meta {
  name: Request OTP
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/client/auth/request-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "phone": "{{client_phone}}"
  }
}

docs {
  # Request OTP

  Sends a 6-digit OTP to the phone via the SMS gateway
  (`socket-server/` → Flutter OTP Listener). TTL = `OTP_TTL_MINUTES` (default 3).

  Any valid phone may request OTP (auto-registers on verify). Rate limited:
  3 req/min per IP and per phone (`throttle:otp-request`).

  **Response 200:**
  ```json
  {
    "message": "OTP sent.",
    "delivery": "sms",
    "delivery_message": null
  }
  ```

  `delivery` may be `"manual"` when SMS is unavailable.

  **Errors:**
  - `422` — phone validation error
  - `429` — too many requests
}
