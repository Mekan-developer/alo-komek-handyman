APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Initial admin user created by DatabaseSeeder. Both required — the admin
# user is skipped (no hardcoded fallback) if either is missing.
ADMIN_EMAIL=
ADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# resilient = обёртка, которая при недоступном Reverb пишет warning вместо исключения
BROADCAST_CONNECTION=resilient
BROADCAST_RESILIENT_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Laravel Reverb (WebSocket). Запуск: php artisan reverb:start --port=8880
# Если сервер не поднят, приложение продолжает работать: события только логируются
# (драйвер `resilient`), а фронтенд не создаёт Echo без VITE_REVERB_APP_KEY.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="127.0.0.1"
REVERB_PORT=8880
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Self-hosted vector basemap. Style URL is shared to the frontend via Inertia.
# Dev: local static style.json + /tiles/{z}/{x}/{y}.pbf route reading storage/maps/tiles.mbtiles — no Docker needed.
# To use tileserver-gl instead, point this at its style URL (e.g. http://localhost:8080/styles/basic-preview/style.json).
TILES_STYLE_URL="/maps/style.json"

# Path to the local .mbtiles file, relative to storage/. Used by the /tiles/{z}/{x}/{y}.pbf route.
MBTILES_PATH=maps/tiles.mbtiles

# Socket.IO bridge (socket-server/) — relays OTP codes to the Flutter SMS-gateway phone.
# Must match PORT / GATEWAY_SECRET in socket-server/.env
SMS_GATEWAY_URL=http://127.0.0.1:3000
SMS_GATEWAY_SECRET=changeme
OTP_TTL_MINUTES=3

# Store-review accounts: these phones sign in with OTP_TEST_CODE and never receive an SMS.
# Comma-separated; leave either value empty to disable the bypass.
OTP_TEST_PHONES=+99362222222
OTP_TEST_CODE=010101
